{
  "name": "@rockin-in-a-free-world/mdk-app-fleet",
  "version": "0.1.0",
  "description": "Fleet overview and power control for MDK sites",
  "keywords": [
    "mdk",
    "mdk-app"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@tetherto/mdk-client": "file:../mdk-tech-stack/backend/core/client"
  },
  "files": [
    "mdk-app.yaml",
    "plugin/",
    "ui/",
    "README.md"
  ],
  "scripts": {
    "build:ui": "npm --prefix ui-src run build",
    "dev:ui": "npm --prefix ui-src run dev",
    "typecheck:ui": "npm --prefix ui-src run typecheck",
    "typecheck:plugin": "npm --prefix ui-src run typecheck:plugin",
    "typecheck": "npm run typecheck:plugin && npm run typecheck:ui",
    "lint": "npm --prefix ui-src run lint",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rockin-in-a-free-world/mdk-app.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
